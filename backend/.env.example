# Copy to backend/.env. Never commit .env.
BRIDGE_URL=ws://100.64.0.12:8765          # foxglove_bridge on the Pi (Tailscale IP)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SESSION=                                   # blank = auto "live-YYYYmmdd-HHMM"; or POST /session
VOC_UNIT=ppb                                # ppb (SGP30 TVOC) | index (SGP40)
VOC_THRESHOLD=2200                          # ppb: >2200 alert · index: >250
VOC_HOLD_SECONDS=5
ALERT_COOLDOWN_SECONDS=60
WARN_THRESHOLD=100                          # spoken Gemini warning above this (ppb), hold 3 s, cooldown 90 s
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL     # Sarah (an account voice; library voices like Rachel need a paid plan)
