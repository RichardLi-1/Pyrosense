// Cloudflare deploy of the dashboard + landing page:  npm run deploy:cf  (builds, then `wrangler deploy`).
// Static files come from dist/. The Worker runs first on every request: /api/track posts visits to
// Discord, /api/* and /ws/* are proxied to the Vultr backend, and page requests are checked for
// AI-assistant fetchers. Secret: `npx wrangler secret put DISCORD_WEBHOOK_URL` (docs/visitor-tracking.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pyrosense",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // unknown paths fall back to the dashboard's index.html; /landing redirects to /landing/
    "not_found_handling": "single-page-application",
    // every request, so the Worker can see AI assistants fetching pages (they never run our JS)
    "run_worker_first": true
  },
  "vars": {
    // The Vultr VM's nginx. A hostname is required (Cloudflare blocks fetches to bare IPs);
    // sslip.io resolves 216-128-184-212.sslip.io to 216.128.184.212. Swap in a real domain once there is one.
    "BACKEND": "http://216-128-184-212.sslip.io"
  },
  "observability": { "enabled": true }
}
