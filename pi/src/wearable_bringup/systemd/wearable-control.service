# sudo cp ~/ros2_ws/src/hazard/wearable_bringup/systemd/wearable-control.service /etc/systemd/system/
# sudo systemctl enable --now wearable-control
[Unit]
Description=Wearable control endpoint (:8766, restart scan)
After=network-online.target

[Service]
User=htvteam3
ExecStart=/usr/bin/python3 /home/htvteam3/ros2_ws/src/hazard/wearable_bringup/control/pi_control.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
