<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voc_sensor</name>
  <version>0.1.0</version>
  <description>SGP30 VOC driver and map-frame point mapper for the wearable</description>
  <maintainer email="jonathan@brikli.com">hazard team</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>voc_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros_py</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
